# Set these server-side in Vercel.
# Set SITE_URL to the canonical HTTPS frontend URL for public indexing.
SITE_URL=
# Django's HTTPS origin, without a trailing slash.
DJANGO_ORIGIN=
PUBLIC_SUPPORT_EMAIL=

# Visitor analytics. Loads only on the indexable production site. Leave empty to turn off.
# Google Analytics 4 measurement ID (G-XXXXXXXXXX) and Microsoft Clarity project ID.
GA_ID=
CLARITY_ID=
